#: data/kingdoms/mud.tres
msgid "Kontrol (yavaşlatma)"
msgstr "Control (slowing)"

#: data/kingdoms/orcs.tres
msgid "Orklar"
msgstr "Orcs"

#: data/kingdoms/orcs.tres
msgid "Kaba kuvvet. En güçlü savaşçılar ve kalın kalkanlar; savaş davullarıyla hızlı vururlar."
msgstr "Brute force. The strongest warriors and thick shields; war drums make them strike fast."

#: data/kingdoms/slimes.tres
msgid "Slime'lar"
msgstr "Slimes"

#: data/kingdoms/slimes.tres
msgid "Ezildikçe çoğalırlar. Yok olan her bölük iki küçük bölüğe bölünür."
msgstr "Crush them and they multiply. Every destroyed squad splits into two smaller ones."

#: data/kingdoms/slimes.tres
msgid "Sürü (bölünme)"
msgstr "Swarm (splitting)"

#: data/kingdoms/undead.tres
msgid "Ölüler"
msgstr "Undead"

#: data/kingdoms/undead.tres
msgid "Ölüm onları durdurmaz. Yok olan bölükler bir kez daha kalkar."
msgstr "Death does not stop them. Destroyed squads rise once more."

#: data/kingdoms/undead.tres
msgid "Diriliş"
msgstr "Revival"

#: data/passives/centaur_hooves.tres
msgid "Toynak Gürültüsü"
